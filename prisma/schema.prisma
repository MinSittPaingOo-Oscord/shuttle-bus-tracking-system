// Prisma schema for University Shuttle Tracking System

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  extensions = [postgis(schema: "public")]
}

// ============================================
// 1. USERS - Admin Authentication
// ============================================
model User {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username      String   @unique @db.VarChar(50)
  passwordHash  String   @map("password_hash") @db.VarChar(255)
  role          String   @default("ADMIN") @db.VarChar(30)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  assignedFeedback Feedback[] @relation("feedback_assigned_to")
  deletedFeedback  Feedback[] @relation("feedback_deleted_by")

  @@map("users")
}

// ============================================
// 2. ROUTES - Shuttle Routes
// ============================================
model Route {
  id        String   @id @db.VarChar(50)
  name      String   @db.VarChar(255)
  color     String   @db.VarChar(7)
  status    String   @default("active") @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  geometry Unsupported("geography")?
  // Relations
  vehicles   Vehicle[]
  routeStops RouteStop[]
  trips      Trip[]

  @@map("routes")
}

// ============================================
// 3. VEHICLES - Shuttle Buses
// ============================================
model Vehicle {
  id              String   @id @db.VarChar(50)
  name            String   @db.VarChar(255)
  type            String   @db.VarChar(50)
  assignedRouteId String?  @map("assigned_route_id") @db.VarChar(50)
  status          String   @default("inactive") @db.VarChar(50)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  // Relations
  route           Route?           @relation(fields: [assignedRouteId], references: [id])
  trips           Trip[]
  gpsTracks       GPSTrack[]
  feedbacks       Feedback[]
  trackingSources TrackingSource[]

  @@index([status])
  @@index([assignedRouteId])
  @@map("vehicles")
}

// ============================================
// 4. STOPS - Bus Stop Locations
// ============================================
model Stop {
  id        String                    @id @db.VarChar(50)
  nameTh    String                    @map("name_th") @db.VarChar(255)
  nameEn    String?                   @map("name_en") @db.VarChar(255)
  location  Unsupported("geography")? // PostGIS geography type
  imageUrl  String?                   @map("image_url") @db.VarChar(500)
  status    String                    @default("active") @db.VarChar(50)
  createdAt DateTime                  @default(now()) @map("created_at") @db.Timestamp(6)

  // Relations
  routeStops RouteStop[]

  @@index([status])
  @@map("stops")
}

// ============================================
// 5. ROUTE_STOPS - Junction Table
// ============================================
model RouteStop {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  routeId   String @map("route_id") @db.VarChar(50)
  stopId    String @map("stop_id") @db.VarChar(50)
  stopOrder Int    @map("stop_order")

  // Relations
  route Route @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stop  Stop  @relation(fields: [stopId], references: [id], onDelete: Restrict)

  @@unique([routeId, stopOrder])
  @@index([routeId])
  @@index([stopId])
  @@map("route_stops")
}

// ============================================
// 6. TRIPS - Trip Records
// ============================================
model Trip {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vehicleId String    @map("vehicle_id") @db.VarChar(50)
  routeId   String    @map("route_id") @db.VarChar(50)
  startTime DateTime  @map("start_time") @db.Timestamp(6)
  endTime   DateTime? @map("end_time") @db.Timestamp(6)
  // SQL migration constrains this lifecycle to in_progress/completed and
  // requires endTime only for completed trips.
  status    String    @default("in_progress") @db.VarChar(50)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  // Relations
  vehicle   Vehicle    @relation(fields: [vehicleId], references: [id])
  route     Route      @relation(fields: [routeId], references: [id])
  gpsTracks GPSTrack[]

  @@index([vehicleId])
  @@index([routeId])
  @@index([status])
  @@index([startTime(sort: Desc)])
  @@map("trips")
}

// ============================================
// 7. GPS_TRACKS - GPS Time-series Data
// ============================================
model GPSTrack {
  id         BigInt                    @id @default(autoincrement())
  tripId     String                    @map("trip_id") @db.Uuid
  vehicleId  String                    @map("vehicle_id") @db.VarChar(50)
  location   Unsupported("geography")? // PostGIS geography type
  speed      Decimal?                  @db.Decimal(5, 2)
  heading    Decimal?                  @db.Decimal(5, 2)
  station    String?
  sourceId   String?                   @map("source_id") @db.VarChar(50)
  recordedAt DateTime                  @map("recorded_at") @db.Timestamp(6)

  // Relations
  trip    Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  vehicle Vehicle         @relation(fields: [vehicleId], references: [id])
  source  TrackingSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([tripId])
  @@index([vehicleId, recordedAt(sort: Desc)])
  @@index([sourceId, recordedAt(sort: Desc)])
  @@map("gps_tracks")
}

// ============================================
// 8. TRACKING_SOURCES - Physical Devices
// ============================================
model TrackingSource {
  id         String    @id @db.VarChar(50)
  name       String    @db.VarChar(255)
  type       String    @db.VarChar(50) // "mobile", "lorawan", "esp32", "simulator"
  vehicleId  String?   @map("vehicle_id") @db.VarChar(50)
  priority   Int       @default(1)
  status     String    @default("active") @db.VarChar(50)
  secretHash String?   @map("secret_hash") @db.VarChar(255)
  credentialVersion   Int       @default(1) @map("credential_version")
  credentialIssuedAt  DateTime? @map("credential_issued_at") @db.Timestamp(6)
  credentialRotatedAt DateTime? @map("credential_rotated_at") @db.Timestamp(6)
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamp(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  // Relations
  vehicle   Vehicle?   @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  gpsTracks GPSTrack[]

  @@index([vehicleId, status, priority, id])
  @@index([status, lastSeenAt(sort: Desc)])
  @@map("tracking_sources")
}

// ============================================
// 9. FEEDBACK - User Feedback
// ============================================
model Feedback {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type             String?   @db.VarChar(50)
  vehicleId        String?   @map("vehicle_id") @db.VarChar(50)
  message          String?   @db.Text
  ipAddress        String?   @map("ip_address") @db.Inet
  status           String    @default("new") @db.VarChar(30)
  assignedToId     String?   @map("assigned_to_id") @db.Uuid
  assignedAt       DateTime? @map("assigned_at") @db.Timestamp(6)
  acknowledgedAt   DateTime? @map("acknowledged_at") @db.Timestamp(6)
  investigatingAt  DateTime? @map("investigating_at") @db.Timestamp(6)
  resolvedAt       DateTime? @map("resolved_at") @db.Timestamp(6)
  internalNote     String?   @map("internal_note") @db.Text
  deletedAt        DateTime? @map("deleted_at") @db.Timestamp(6)
  deletedById      String?   @map("deleted_by_id") @db.Uuid
  deletionReason   String?   @map("deletion_reason") @db.VarChar(500)
  restoreExpiresAt DateTime? @map("restore_expires_at") @db.Timestamp(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  // Relations
  vehicle    Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  assignedTo User?    @relation("feedback_assigned_to", fields: [assignedToId], references: [id], onDelete: SetNull)
  deletedBy  User?    @relation("feedback_deleted_by", fields: [deletedById], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([type])
  @@index([vehicleId])
  @@index([status, createdAt(sort: Desc)])
  @@index([deletedAt, restoreExpiresAt])
  @@map("feedback")
}

model FeedbackAuditEvent {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  feedbackId   String   @map("feedback_id") @db.Uuid
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  action       String   @db.VarChar(50)
  eventKey     String?  @map("event_key") @db.VarChar(50)
  fromStatus   String?  @map("from_status") @db.VarChar(30)
  toStatus     String?  @map("to_status") @db.VarChar(30)
  reason       String?  @db.VarChar(500)
  occurredAt   DateTime @default(now()) @map("occurred_at") @db.Timestamp(6)

  @@index([feedbackId, occurredAt(sort: Desc)])
  @@unique([feedbackId, eventKey])
  @@map("feedback_audit_events")
}
